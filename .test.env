ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# Used by root docker-compose.yml for the life-manager service env_file path.
ENV_FILE=.test.env


APP_PORT=3000
FRONTEND_PORT=8080

DATABASE_URL=./data/test.db
TEST_TENANT_DATABASE_URL=file:./data/test-tenant.db
RUST_LOG=debug

JWT_SECRET=test-secret
RUST_BACKTRACE=1

EMAIL_PROVIDER=log
APP_PUBLIC_BASE_URL=https://life-manager.jeszenka.com
